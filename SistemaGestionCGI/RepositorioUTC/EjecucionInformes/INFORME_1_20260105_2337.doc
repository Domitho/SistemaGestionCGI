<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'><head><meta charset='utf-8'><style>@page Section1 {    size: 841.9pt 595.3pt;    mso-page-orientation: landscape;    margin: 2.0cm 2.0cm 2.0cm 2.0cm;}div.Section1 { page: Section1; }@page { size: landscape; margin: 2cm; }body { font-family: 'Times New Roman', serif; font-size: 11pt; line-height: 1.15; margin: 0; }.text-center { text-align: center; }.text-bold { font-weight: bold; }.uppercase { text-transform: uppercase; }.center-data { text-align: center !important; }.info-table { width: 100%; border-collapse: collapse; margin-bottom: 20px; border: none; }.info-table td { border: none; padding: 4px 0; vertical-align: top; font-size: 11pt; }.label-col { width: 25%; font-weight: bold; }.value-col { width: 75%; }.main-table { width: 100%; border-collapse: collapse; margin-top: 5px; table-layout: fixed; }.main-table th { background-color: #D9D9D9; border: 1px solid #000; padding: 6px; font-size: 10pt; font-weight: bold; text-align: center; vertical-align: middle; }.main-table td { border: 1px solid #000; padding: 6px; font-size: 10pt; vertical-align: middle; text-align: left; word-wrap: break-word; }</style></head><body><div class='Section1'><div class='text-center text-bold uppercase' style='font-size:14pt; margin-bottom: 30px;'>FORMATO PARA LOS INFORME DE AVANCES POR PERIÓDOS ACADÉMICOS<br>DEL PROYECTO ACADÉMICO CIENTÍFICO</div><table class='info-table'><tr><td class='label-col'>Nombre del proyecto:</td><td class='value-col'>PRUEBA DE PROYECTO 1</td></tr><tr><td class='label-col'>Grupo de Investigación al que pertenece:</td><td class='value-col'>UTC</td></tr><tr><td class='label-col'>Período de seguimiento:</td><td class='value-col'>OCTUBRE 2025 - MARZO 2026</td></tr></table><div class='text-bold uppercase' style='margin-bottom: 8px; font-size: 11pt;'>ACTIVIDADES PLANIFICADAS - ACTIVIDADES EJECUTADAS Y RESULTADOS</div><table class='main-table'><thead><tr><th style='width:15%'>COMPONENTE /<br>OBJETIVOS</th><th style='width:19%'>ACTIVIDADES<br>PLANIFICADAS</th><th style='width:19%'>ACTIVIDADES<br>EJECUTADAS</th><th style='width:15%'>DOCENTES /<br>INVESTIGADORES</th><th style='width:10%'>INSTITUCIÓN /<br>CARRERA</th><th style='width:7%'>% DE<br>CUMP.</th><th style='width:15%'>RESULTADOS<br>ALCANZADOS</th></tr></thead><tbody><tr><td>dedeede</td><td>dede</td><td>dede</td><td>dededde</td><td class='center-data'>dedeededddd</td><td class='center-data'>58%</td><td>ededed</td></tr></tbody></table></div></body></html>