<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="SistemaGestionCGI.SiteMaster" %>

<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="es">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>UTC - Sistema Integrado de Gestión</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Varela+Round&display=swap" rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />

    <link href="https://cdn.datatables.net/v/bs5/dt-1.13.8/r-2.5.0/b-2.4.2/datatables.min.css" rel="stylesheet" />

    <link href="~/DesignersUTC/Styles/utc-full-design.css" rel="stylesheet" />

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        function mostrarBienvenida(nombre, rol) {
            Swal.fire({
                title: '<span style="color:#312783">¡Bienvenido de nuevo!</span>',
                html: `<p class="fs-5 mt-2">Hola <b>${nombre}</b></p>
                       <span class="badge rounded-pill text-bg-success px-3 py-2 fs-6 mt-1">${rol}</span>`,
                icon: 'success',
                iconColor: '#312783',
                timer: 3000,
                timerProgressBar: true,
                showConfirmButton: false,
                backdrop: `rgba(49, 39, 131, 0.2) left top no-repeat`,
                customClass: {
                    popup: 'shadow-lg border-0 rounded-4'
                }
            });
        }
    </script>

    <script>
        function confirmarEliminar(source, mensaje, e) {
            e = e || window.event;
            if (source.dataset.confirmed === "true") {
                return true;
            }

            if (e.preventDefault) e.preventDefault();
            else e.returnValue = false;

            Swal.fire({
                title: '<span style="color:#312783">¿Está seguro?</span>',
                html: mensaje || "Esta acción eliminará el registro permanentemente.",
                icon: 'warning',
                iconColor: '#d9534f',
                showCancelButton: true,
                confirmButtonColor: '#d9534f',
                cancelButtonColor: '#312783',
                confirmButtonText: '<i class="fa-solid fa-trash"></i> Sí, eliminar',
                cancelButtonText: 'Cancelar',
                backdrop: `rgba(49, 39, 131, 0.1)`,
                customClass: {
                    popup: 'shadow-lg border-0 rounded-4'
                },
                allowOutsideClick: false, 
                allowEscapeKey: false
            }).then((result) => {
                if (result.isConfirmed) {
                    source.dataset.confirmed = "true";
                    
                    __doPostBack(source.name, '');
                }
            });

            return false;
        }

        function confirmarRestaurar(source, mensaje) {
            if (source.dataset.confirmed === "true") {
                return true;
            }

            event.preventDefault();

            Swal.fire({
                title: '<span style="color:#312783">¿Está seguro?</span>',
                text: mensaje || "Esta acción restaurara el registro del integrante",
                icon: 'warning',
                iconColor: '#d9534f',
                showCancelButton: true,
                confirmButtonColor: '#d9534f',
                cancelButtonColor: '#312783',
                confirmButtonText: '<i class="fa-solid fa-trash"></i> Sí, restaurar',
                cancelButtonText: 'Cancelar',
                backdrop: `rgba(49, 39, 131, 0.1)`,
                customClass: {
                    popup: 'shadow-lg border-0 rounded-4'
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    source.dataset.confirmed = "true";
                    source.click();
                }
            });

            return false;
        }

    </script>

    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    <script>
        function toastify(type, msg, title) {
            toastr.options = {
                closeButton: true,
                progressBar: true,
                positionClass: "toast-top-right",
                timeOut: "4000"
            };

            var validTypes = ['success', 'info', 'warning', 'error'];
            if (!validTypes.includes(type)) type = 'info';
            if (type === 'ee') type = 'error';
            if (type === 'ss') type = 'success';
            if (type === 'ww') type = 'warning';

            toastr[type](msg, title || 'Sistema UTC');
        }
    </script>

    <asp:ContentPlaceHolder ID="HeadContent" runat="server"></asp:ContentPlaceHolder>
</head>

<body class="bg-light d-flex flex-column min-vh-100">
    <form runat="server" enctype="multipart/form-data" class="d-flex flex-column flex-grow-1">

        <asp:ScriptManager ID="ScriptManager" runat="server" EnablePageMethods="true" />

        <div id="containerDiv" runat="server" class="utc-container container-fluid mx-auto my-3 d-flex flex-column flex-grow-1" style="max-width: 1400px;">

            <header class="shadow-sm rounded-3 bg-white">
