                    <div class="utc-header-logo">
                        <img width="200" src="https://aplicaciones.utc.edu.ec/sigutc/img/bnUTC.png" alt="UTC Logo" class="img-fluid" />
                    </div>

                    <div class="utc-header-title text-center flex-grow-1 mx-3 d-none d-md-block">
                        <h5 class="m-0 fw-bold text-white text-uppercase tracking-wide" style="letter-spacing: 2px; opacity: 0.9;">
                            Sistema Integrado de Gestión
                        </h5>
                    </div>

                    <div class="text-end text-white utc-header-user">
                        <small class="d-block text-white-50" style="font-size: 0.75rem;">BIENVENIDO!</small>
                        <asp:Label runat="server" ID="lblNombre" CssClass="fw-bold d-block text-truncate" style="max-width: 150px; font-size: 0.9rem;"></asp:Label>
                        <asp:Button ID="btnCerrarSesion" runat="server"
                            OnClick="btnCerrarSesion_Click"
                            Text="Cerrar Sesión"
                            CausesValidation="false"
                            CssClass="btn btn-outline-light btn-sm mt-2 rounded-pill px-3 py-1"
                            style="font-size: 0.75rem;" />
                    </div>
                </div>

                <nav id="navbarDiv" runat="server" class="navbar navbar-expand-lg navbar-dark utc-navbar">
                    <div class="container-fluid">

                        <a class="navbar-brand fw-bold text-white fs-4 tracking-wide" href="Dashboard.aspx" style="letter-spacing: 1px;">
                            UTC
                        </a>

                        <button class="navbar-toggler ms-auto" type="button" data-bs-toggle="collapse"
                            data-bs-target="#mainNavbar" aria-controls="mainNavbar"
                            aria-expanded="false" aria-label="Toggle navigation">
                            <span class="navbar-toggler-icon"></span>
                        </button>

                        <div class="collapse navbar-collapse" id="mainNavbar">
                            <ul class="navbar-nav w-100 justify-content-end mb-2 mb-lg-0">

                                <li class="nav-item">
                                    <a class="nav-link" href="Dashboard.aspx" id="lnkMenuDashboard" runat="server">
                                        <i class="fa-solid fa-chart-line"></i> Dashboard
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link" href="GestionUsuarios.aspx" id="lnkMenuUsuarios" runat="server">
                                        <i class="fa-solid fa-users-gear"></i> Usuarios
                                    </a>
                                </li>

                                <li class="nav-item dropdown" id="liDropdownGrupos" runat="server">
                                    <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownGrupos" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="fa-solid fa-people-group"></i> Grupos Investigación
                                    </a>
                                    <ul class="dropdown-menu shadow-utc border-0" style="width: auto !important; min-width: 240px;" aria-labelledby="navbarDropdownGrupos">
                                        <li><a class="dropdown-item" href="ConvocatoriaGruInvestigacion.aspx" id="lnkMenuConvocatorias" runat="server"><i class="fa-solid fa-bullhorn text-primary"></i> Convocatorias</a></li>
                                        <li><a class="dropdown-item" href="CentrosInvestigacion.aspx" id="lnkMenuCentros" runat="server"><i class="fa-solid fa-building-columns text-primary"></i> Centros Investigación</a></li>
                                        <li><hr class="dropdown-divider" /></li>
                                        <li><a class="dropdown-item" href="GruposInvestigacion.aspx" id="lnkMenuGrupos" runat="server"><i class="fa-solid fa-people-group text-primary"></i> Grupos Investigación</a></li>
                                        <li><hr class="dropdown-divider" /></li>
                                        <li><a class="dropdown-item" href="CalificacionGruInvestigacion.aspx" id="lnkMenuCalificacion" runat="server"><i class="fa-solid fa-star text-warning"></i> Calificación Grupos</a></li>
                                        <li><a class="dropdown-item" href="CategorizacionDocentes.aspx" id="lnkMenuCategorizacion" runat="server"><i class="fa-solid fa-id-card text-primary"></i> Categorización Docentes</a></li>
                                    </ul>
                                </li>

                                <li class="nav-item dropdown" id="liDropdownProyectos" runat="server">
                                    <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownProyectos" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="fa-solid fa-folder-open"></i> Proyectos Inv.
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end shadow-utc border-0" style="width: auto !important; min-width: 240px;" aria-labelledby="navbarDropdownProyectos">
                                        <li><a class="dropdown-item" href="InscripcionProyectos.aspx" id="lnkMenuInscripcion" runat="server"><i class="fa-solid fa-file-contract text-primary"></i> Inscripción Proyectos</a></li>
                                        <li><a class="dropdown-item" href="EjecucionProAprobados.aspx" id="lnkMenuEjecucion" runat="server"><i class="fa-solid fa-person-digging text-primary"></i> Ejecución Proyectos</a></li>
                                    </ul>
                                </li>

                            </ul>
                        </div>
                    </div>
                </nav>
            </header>

            <main class="p-4 flex-grow-1 py-3">
                <div class="utc-content-wrapper">
                    <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>
                </div>
            </main>

            <footer id="footerDiv" runat="server" class="text-center py-3 mt-auto border-top bg-white rounded-3 shadow-sm">
                <p class="text-muted small m-0">
                    © <script>document.write(new Date().getFullYear())</script> <strong>Universidad Técnica de Cotopaxi</strong> | Dirección de Investigación
                </p>
                <asp:Label ID="lblFecha" runat="server" Visible="false"></asp:Label>
            </footer>

        </div>

    </form>

    <%-- Dependencias exportación: primero --%>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>

    <%-- DataTables base + Bootstrap 5 + Responsive + Buttons core --%>
    <script src="https://cdn.datatables.net/v/bs5/dt-1.13.8/r-2.5.0/b-2.4.2/datatables.min.js"></script>

    <%-- Plugins específicos de exportación --%>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.print.min.js"></script>

    <%-- Visor PDF --%>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
    <script>
        if (window['pdfjsLib']) {
            pdfjsLib.GlobalWorkerOptions.workerSrc = "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js";
        }
    </script>

    <script type="text/javascript">
        function UTC_BloquearBoton(btn) {
            if (typeof (Page_ClientValidate) == 'function') {
                if (Page_ClientValidate() == false) {
                    return false;
                }
            }

            btn.style.width = getComputedStyle(btn).width;
            btn.classList.add('utc-btn-loading');
            btn.innerHTML = '<span class="utc-spinner"></span> Procesando...';

            setTimeout(function () {
                btn.disabled = true;
            }, 0);

            return true;
        }
    </script>

</body>
</html>